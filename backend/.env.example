# Copiar a backend/.env y completar valores reales

# ---------- MySQL ----------
# En Railway se toman automáticamente MYSQLHOST, MYSQLUSER, etc.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=alta_densidad_data

# ---------- Servidor público (panel DATA) ----------
PORT=5000
NODE_ENV=production
# Secreto para firmar sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Dominio(s) del panel DATA separados por coma. Ej: https://altadensidaddata.up.railway.app
ALLOWED_ORIGINS=

# ---------- Integración privada con la tienda web ----------
# Puerto SOLO interno: NO asignarle dominio público en Railway.
INTEGRATION_PORT=7070
# Mismo valor que DATA_INTEGRATION_SECRET en el backend de la web (mínimo 32 caracteres).
INTEGRATION_SECRET=
